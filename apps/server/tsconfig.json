{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "Preserve",
    "moduleResolution": "bundler",
    "noEmit": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "noUncheckedIndexedAccess": true,
    /* 前端经 hono/client 从 App 推断接口类型，类型检查会按前端的配置读到这里的源码，那边开着它 */
    "erasableSyntaxOnly": true,
    "types": ["bun"],
    "paths": {
      "@server/*": ["./src/*"]
    }
  }
}
