# 复制成同目录下的 .env 再填（已被 Git 忽略）。容器部署不放这个文件，全用同名的环境变量。
# 时长写成整数加单位：ms / s / m / h / d，如 30d、24h、30s。

# 必填。PostgreSQL 连接串；服务启动时自动执行迁移，这个账号要有建表、改表的权限。
DATABASE_URL=postgres://postgres:postgres@localhost:5432/myapi

# 必填，至少 32 字节。登录令牌与图片地址的签名密钥都由它派生，换掉等于让所有人重新登录、所有图片地址失效。
# 生成：openssl rand -hex 32
SECRET_KEY=

# 是否开放注册，默认 false。要建第一个账号就临时改成 true，注册完改回来重启。
# ALLOW_REGISTRATION=false

# 登录令牌有效期，默认 30d。
# TOKEN_TTL=30d

# 签名图片地址的有效期，默认 24h。
# ATTACHMENT_TTL=24h

# 出网请求（e 站、图床、节假日数据源）的超时，默认 30s；等到响应头之后，按多久没收到数据算。超过 5m 不生效（Bun 的 fetch 自带 5 分钟的空闲上限）。
# EH_REQUEST_TIMEOUT=30s

# 出网请求（e 站、图床、节假日数据源）伪装的 User-Agent，默认是一个桌面 Chrome 的。
# EH_USER_AGENT=Mozilla/5.0 ...

# 监听端口，默认 8000。
# PORT=8000
