# 复制成 .env 后填好再启动。只有 EH_SECRET_KEY 是必填的，其余留空即用 src/config.ts 里的默认值。

# 必填。登录令牌签名和图片地址签名都由它派生子密钥，缺了进程直接拒绝启动。
# 生成：openssl rand -hex 32
EH_SECRET_KEY=

# 注册默认关闭。要建第一个账号就临时设成 true，注册完改回来重启。
# ALLOW_REGISTRATION=false

# DATABASE_URL=postgres://postgres:postgres@localhost:5432/myapi
# PORT=8000
# TOKEN_TTL_MS=2592000000
# ATTACHMENT_TTL_MS=86400000
# LOG_LEVEL=info
