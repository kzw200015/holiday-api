{
  "name": "myapi",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun --watch src/main.ts | pino-pretty",
    "start": "bun src/main.ts",
    "typecheck": "tsc",
    "test": "bun --bun vitest run",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@hono/zod-validator": "^0.9.1",
    "croner": "^10.0.1",
    "drizzle-orm": "1.0.0-rc.4",
    "hono": "^4.13.12",
    "ms": "^2.1.3",
    "pino": "^10.3.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "@testcontainers/postgresql": "^12.2.0",
    "@types/bun": "^1.4.2",
    "@types/ms": "^2.1.0",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "1.0.0-rc.4",
    "oxlint": "^1.86.0",
    "pino-pretty": "^13.1.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.3"
  }
