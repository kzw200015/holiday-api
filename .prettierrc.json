{
  "semi": false,
  "printWidth": 120,
  "plugins": ["@ianvs/prettier-plugin-sort-imports"],
  "importOrder": ["<BUILTIN_MODULES>", "<THIRD_PARTY_MODULES>", "", "^@/(.*)$", "^@server/(.*)$", "^[./]"],
  "importOrderParserPlugins": ["typescript"],
  "importOrderTypeScriptVersion": "6.0.3",
  "overrides": [
    {
      "files": "*.jsonc",
      "options": {
        "trailingComma": "none"
      }
    }
  ]
}
